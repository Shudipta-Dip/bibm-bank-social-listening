# Copy to .env and fill in. Never commit .env.

# Meta Graph API Page access tokens (owned Pages — free)
META_PAGE_TOKEN_BRAC=
META_PAGE_TOKEN_SCB=

# Optional: Graph API version
META_GRAPH_VERSION=v21.0

# LinkedIn research account (optional; storage state preferred after first login)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
# Path to Playwright storage state JSON after HITL login (H5)
LINKEDIN_STORAGE_STATE=browser_profiles/linkedin_storage.json

# Facebook Playwright session (fallback when no Page token)
FACEBOOK_STORAGE_STATE=browser_profiles/facebook_storage.json
# Set to 1 to force interactive Facebook login before scraping (deeper feed)
FACEBOOK_REQUIRE_LOGIN=1
# Attach to a manually launched, authenticated Chrome for BCUB group searches.
# Keep this endpoint bound to localhost; never expose it on the network.
FACEBOOK_CDP_URL=http://127.0.0.1:9222

# Headed browser for social collectors (1=headed, 0=headless)
BROWSER_HEADED=1
